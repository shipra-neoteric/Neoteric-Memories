# Copy this file to apps/api/.env and fill in real values before deploying.
# For local development, every value below has a safe default and can be left unset —
# see docs/SETUP.md.

NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000

# Leave empty to auto-boot a throwaway in-process MongoDB with zero setup (dev/demo
# only — data does not persist across restarts, and the dev server also auto-seeds
# demo data in this mode). Set this to a real MongoDB Atlas connection string for any
# persistent or shared environment:
#   DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/neoteric_memories?retryWrites=true&w=majority
DATABASE_URL=

# REQUIRED in production — generate with `openssl rand -base64 48` (or similar).
# The insecure dev defaults below are refused outright when NODE_ENV=production.
JWT_SECRET=dev-only-insecure-secret-change-me-please-32chars
COOKIE_SECRET=dev-only-insecure-cookie-secret-change-me-32c
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_HOURS=12

# Storage provider: "local" (writes to LOCAL_STORAGE_DIR, dev/demo only) or "s3"
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only needed for an S3-compatible endpoint that isn't AWS (MinIO, R2, etc).
S3_ENDPOINT=

# Face search provider: "mock" (deterministic, no AWS needed — see docs/FACE_PROVIDER.md)
# or "rekognition" (requires AWS credentials below)
FACE_PROVIDER=mock
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Policy defaults — see packages/shared/src/constants.ts for the code defaults these
# override, and docs/PRIVACY.md for what each one means. Not calibrated for
# production; review with Neoteric's legal/privacy team before go-live.
HIGH_CONFIDENCE_THRESHOLD=92
GUEST_SESSION_TTL_HOURS=24
SIGNED_URL_TTL_MINUTES=15
SELFIE_MAX_RETENTION_HOURS=24
MAX_SELFIE_ATTEMPTS_PER_SESSION=5
MAX_SEARCHES_PER_DEVICE_PER_EVENT=8

# CAPTCHA is disabled by default (rate limiting + session/device counters are the
# default compensating control instead). The interface is wired up so turning this on
# later needs no route changes — but "recaptcha"/"turnstile" have no concrete
# implementation yet in L1 (see providers/captcha).
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=none
CAPTCHA_SECRET_KEY=

# Liveness detection: "mock" (always passes — dev/demo only) or "aws" (not
# implemented in L1, see docs/AWS_DEPLOYMENT.md)
LIVENESS_PROVIDER=mock

# Google Drive continuous folder sync (optional). Leave both unset to disable the
# feature entirely — the "Connect Google Drive" button is hidden on the event page
# when these aren't configured. See docs/GOOGLE_DRIVE.md for full setup steps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client in Google
# Cloud Console. Leave unset to default to {API_BASE_URL}/api/admin/integrations/google/callback.
GOOGLE_OAUTH_REDIRECT_URI=
DRIVE_SYNC_INTERVAL_MINUTES=3
