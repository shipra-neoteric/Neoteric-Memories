{
  "framework": null,
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build -w @neoteric-memories/shared && npm run build -w @neoteric-memories/api",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/lib/heicConvertWorker.js",
      "maxDuration": 60
    }
  },
  "crons": [{ "path": "/internal/cron", "schedule": "0 3 * * *" }]
}
